# Base URL the browser uses to call the API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Base URL used for server-side (SSR) requests inside the Docker network
INTERNAL_API_URL=http://backend:3001/api

# Must match the backend's APP_TIMEZONE — the company's single operating timezone, used to
# display attendance check-in/check-out times consistently regardless of viewer or render location.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# Browser alerts (Firebase). The project settings and web push key are already built into
# src/lib/firebase-config.ts. Set these only to override them (for example a different Firebase project).
# NEXT_PUBLIC_ values are baked in when the site is built, so rebuild after changing them.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
