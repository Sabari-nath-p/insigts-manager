# Used by docker-compose.yml. Copy to .env and adjust before running `docker compose up`.

# MySQL
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST_PORT=3307
DB_DATABASE=insights_db
DB_USERNAME=insights_user
DB_PASSWORD=insights_password

# Backend
JWT_SECRET=super_secret_change_me_in_production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

# Bootstraps the first super admin account on first startup
SUPER_ADMIN_EMAIL=admin@insights.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=0000000000

# Frontend (must be reachable from the browser, not just inside Docker)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
