# Server
NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# MySQL Database
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=insights_user
DB_PASSWORD=insights_password
DB_DATABASE=insights_db
# Auto-creates tables from entities; set to false once real migrations are in place.
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=super_secret_change_me_in_production
JWT_EXPIRES_IN=1d

# The single timezone the company operates in — used to interpret "HH:mm" schedule times and
# admin-entered attendance corrections. Must match the frontend's NEXT_PUBLIC_APP_TIMEZONE.
APP_TIMEZONE=Asia/Kolkata

# Bootstraps the very first super admin account on first startup (no-op once any
# super admin already exists in the database).
SUPER_ADMIN_EMAIL=admin@insights.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=0000000000

# Browser push notifications (free). Generate once with: npm run notifications:keys
# Leave blank to disable push; in-app notifications keep working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@insights.local
